# Consumer of the native test graph shared with obs-build. Paths in the graph
# are repository-relative; runtime substitutions are deliberately limited.
include_guard(GLOBAL)

function(_obs_test_graph_fields json path allowed)
  string(JSON kind TYPE "${json}" ${path})
  if(NOT kind STREQUAL "OBJECT")
    message(FATAL_ERROR "Native test graph ${path} must be an object")
  endif()
  string(JSON count LENGTH "${json}" ${path})
  if(count GREATER 0)
    math(EXPR last "${count} - 1")
    foreach(index RANGE ${last})
      string(JSON field MEMBER "${json}" ${path} ${index})
      if(NOT field IN_LIST allowed)
        message(FATAL_ERROR "Unknown native test graph field ${path}/${field}")
      endif()
    endforeach()
  endif()
endfunction()

function(_obs_test_graph_array output json)
  string(JSON kind ERROR_VARIABLE error TYPE "${json}" ${ARGN})
  if(error)
    set(${output} "" PARENT_SCOPE)
    return()
  endif()
  if(NOT kind STREQUAL "ARRAY")
    message(FATAL_ERROR "Native test graph field ${ARGN} must be an array")
  endif()
  set(values)
  string(JSON count LENGTH "${json}" ${ARGN})
  if(count GREATER 0)
    math(EXPR last "${count} - 1")
    foreach(index RANGE ${last})
      string(JSON kind TYPE "${json}" ${ARGN} ${index})
      if(NOT kind STREQUAL "STRING")
        message(FATAL_ERROR "Native test graph ${ARGN} entries must be strings")
      endif()
      string(JSON value GET "${json}" ${ARGN} ${index})
      string(REPLACE ";" "\\;" value "${value}")
      list(APPEND values "${value}")
    endforeach()
  endif()
  set(${output} "${values}" PARENT_SCOPE)
endfunction()

function(_obs_test_graph_requirement output json)
  string(JSON kind ERROR_VARIABLE error TYPE "${json}" ${ARGN})
  if(error)
    set(${output} TRUE PARENT_SCOPE)
    return()
  endif()
  string(JSON value GET "${json}" ${ARGN})
  if(kind STREQUAL "BOOLEAN")
    set(${output} "${value}" PARENT_SCOPE)
  elseif(kind STREQUAL "STRING")
    if(NOT DEFINED ${value})
      message(FATAL_ERROR "Unknown native test requirement ${value}")
    endif()
    if(${value})
      set(${output} TRUE PARENT_SCOPE)
    else()
      set(${output} FALSE PARENT_SCOPE)
    endif()
  elseif(kind STREQUAL "OBJECT")
    string(JSON count LENGTH "${json}" ${ARGN})
    if(NOT count EQUAL 1)
      message(FATAL_ERROR "Native test requirement must have exactly one operator")
    endif()
    string(JSON operator MEMBER "${json}" ${ARGN} 0)
    if(operator STREQUAL "not")
      _obs_test_graph_requirement(selected "${json}" ${ARGN} not)
      if(selected)
        set(selected FALSE)
      else()
        set(selected TRUE)
      endif()
    elseif(operator STREQUAL "all" OR operator STREQUAL "any")
      string(JSON kind TYPE "${json}" ${ARGN} ${operator})
      if(NOT kind STREQUAL "ARRAY")
        message(FATAL_ERROR "Native test requirement ${operator} must be an array")
      endif()
      string(JSON count LENGTH "${json}" ${ARGN} ${operator})
      if(operator STREQUAL "all")
        set(selected TRUE)
      else()
        set(selected FALSE)
      endif()
      if(count GREATER 0)
        math(EXPR last "${count} - 1")
        foreach(index RANGE ${last})
          _obs_test_graph_requirement(child "${json}" ${ARGN} ${operator} ${index})
          if(operator STREQUAL "all" AND NOT child)
            set(selected FALSE)
          elseif(operator STREQUAL "any" AND child)
            set(selected TRUE)
          endif()
        endforeach()
      endif()
    else()
      message(FATAL_ERROR "Unknown native test requirement operator ${operator}")
    endif()
    set(${output} "${selected}" PARENT_SCOPE)
  else()
    message(FATAL_ERROR "Invalid native test requirement ${ARGN}")
  endif()
endfunction()

function(_obs_test_graph_expand output value root target)
  string(REPLACE "\${source}" "${root}" value "${value}")
  string(REPLACE "\${build}" "${CMAKE_CURRENT_BINARY_DIR}" value "${value}")
  string(REPLACE "\${target}" "$<TARGET_FILE:${target}>" value "${value}")
  if(value MATCHES "\\$\\{")
    message(FATAL_ERROR "Unknown native test template ${value}")
  endif()
  set(${output} "${value}" PARENT_SCOPE)
endfunction()

function(_obs_test_graph_sources output graph target)
  string(JSON count LENGTH "${graph}" targets "${target}" sources)
  set(sources)
  if(count GREATER 0)
    math(EXPR last "${count} - 1")
    foreach(index RANGE ${last})
      string(JSON kind TYPE "${graph}" targets "${target}" sources ${index})
      if(kind STREQUAL "STRING")
        string(JSON path GET "${graph}" targets "${target}" sources ${index})
        set(selected TRUE)
      elseif(kind STREQUAL "OBJECT")
        _obs_test_graph_fields("${graph}" "targets;${target};sources;${index}" "path;requires")
        string(
          JSON path_kind
          TYPE "${graph}"
          targets
          "${target}"
          sources
          ${index}
          path
        )
        if(NOT path_kind STREQUAL "STRING")
          message(FATAL_ERROR "Invalid native test source path for ${target}")
        endif()
        string(
          JSON path
          GET "${graph}"
          targets
          "${target}"
          sources
          ${index}
          path
        )
        # A conditional source must explicitly declare its requirement.
        string(
          JSON requirement_kind
          TYPE "${graph}"
          targets
          "${target}"
          sources
          ${index}
          requires
        )
        _obs_test_graph_requirement(selected "${graph}" targets "${target}" sources ${index} requires)
      else()
        message(FATAL_ERROR "Invalid native test source for ${target}")
      endif()
      if(path STREQUAL "")
        message(FATAL_ERROR "Empty native test source path for ${target}")
      endif()
      if(selected)
        list(APPEND sources "${path}")
      endif()
    endforeach()
  endif()
  if(NOT sources)
    message(FATAL_ERROR "Native test target ${target} has no selected sources")
  endif()
  set(${output} "${sources}" PARENT_SCOPE)
endfunction()

function(_obs_test_graph_libraries output graph target)
  string(JSON count ERROR_VARIABLE error LENGTH "${graph}" targets "${target}" libraries)
  set(libraries)
  if(NOT error AND count GREATER 0)
    math(EXPR last "${count} - 1")
    foreach(index RANGE ${last})
      string(JSON kind TYPE "${graph}" targets "${target}" libraries ${index})
      if(kind STREQUAL "STRING")
        string(JSON name GET "${graph}" targets "${target}" libraries ${index})
      elseif(kind STREQUAL "OBJECT")
        _obs_test_graph_fields("${graph}" "targets;${target};libraries;${index}" "name;requires")
        _obs_test_graph_requirement(selected "${graph}" targets "${target}" libraries ${index} requires)
        if(NOT selected)
          continue()
        endif()
        string(
          JSON name
          GET "${graph}"
          targets
          "${target}"
          libraries
          ${index}
          name
        )
      else()
        message(FATAL_ERROR "Invalid native test library for ${target}")
      endif()
      list(APPEND libraries "${name}")
    endforeach()
  endif()
  set(${output} "${libraries}" PARENT_SCOPE)
endfunction()

function(obs_native_test_graph path root)
  file(READ "${path}" graph)
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${path}")
  _obs_test_graph_fields("${graph}" "" "schema;targets;tests")
  string(JSON schema GET "${graph}" schema)
  if(NOT schema EQUAL 1)
    message(FATAL_ERROR "Unsupported native test graph schema ${schema}")
  endif()
  set(selected_targets)
  string(JSON count LENGTH "${graph}" targets)
  if(count GREATER 0)
    math(EXPR last "${count} - 1")
    foreach(index RANGE ${last})
      string(JSON name MEMBER "${graph}" targets ${index})
      _obs_test_graph_fields(
        "${graph}"
        "targets;${name}"
        "sources;requires;includes;definitions;packages;header_packages;header_libraries;archives;libraries;compile_options;compile_options_if_supported;link_options;sanitizers"
      )
      _obs_test_graph_requirement(selected "${graph}" targets "${name}" requires)
      if(NOT selected)
        continue()
      endif()
      _obs_test_graph_sources(sources "${graph}" "${name}")
      if(NOT sources)
        message(FATAL_ERROR "Native test target ${name} has no sources")
      endif()
      set(inputs)
      foreach(source IN LISTS sources)
        if(source MATCHES "\\.(c|m)\\.h$|\\.(cpp|mm)\\.hpp$")
          if(source MATCHES "\\.cpp\\.hpp$")
            set(extension cpp)
          elseif(source MATCHES "\\.mm\\.hpp$")
            set(extension mm)
          elseif(source MATCHES "\\.m\\.h$")
            set(extension m)
          else()
            set(extension c)
          endif()
          set(wrapper "${CMAKE_CURRENT_BINARY_DIR}/native-tests/${name}/${source}.${extension}")
          file(GENERATE OUTPUT "${wrapper}" CONTENT "#include \"${root}/${source}\"\n")
          list(APPEND inputs "${wrapper}")
        else()
          list(APPEND inputs "${root}/${source}")
        endif()
      endforeach()
      add_executable(${name} ${inputs})
      target_include_directories(${name} PRIVATE "${root}")
      list(APPEND selected_targets "${name}")
      if(TARGET cmocka-tests)
        add_dependencies(cmocka-tests ${name})
      endif()
      _obs_test_graph_array(includes "${graph}" targets "${name}" includes)
      foreach(directory IN LISTS includes)
        target_include_directories(${name} PRIVATE "${root}/${directory}")
      endforeach()
      _obs_test_graph_array(header_libraries "${graph}" targets "${name}" header_libraries)
      foreach(library IN LISTS header_libraries)
        if(NOT TARGET "${library}")
          message(FATAL_ERROR "Unresolved native test header library ${library}")
        endif()
        get_target_property(header_directories "${library}" INTERFACE_INCLUDE_DIRECTORIES)
        if(header_directories)
          target_include_directories(${name} PRIVATE ${header_directories})
        endif()
      endforeach()
      foreach(field IN ITEMS definitions compile_options link_options)
        _obs_test_graph_array(values "${graph}" targets "${name}" ${field})
        if(NOT values)
          continue()
        endif()
        if(field STREQUAL "definitions")
          foreach(value IN LISTS values)
            if(value MATCHES "\\$\\{target\\}")
              message(FATAL_ERROR "Native test compile definition cannot reference its target executable")
            endif()
            _obs_test_graph_expand(value "${value}" "${root}" "${name}")
            target_compile_definitions(${name} PRIVATE "${value}")
          endforeach()
        elseif(field STREQUAL "compile_options")
          target_compile_options(${name} PRIVATE ${values})
        elseif(field STREQUAL "link_options")
          target_link_options(${name} PRIVATE ${values})
        endif()
      endforeach()
      _obs_test_graph_libraries(libraries "${graph}" "${name}")
      if(libraries)
        target_link_libraries(${name} PRIVATE ${libraries})
      endif()
      foreach(field IN ITEMS packages header_packages)
        _obs_test_graph_array(packages "${graph}" targets "${name}" ${field})
        foreach(package IN LISTS packages)
          find_package(PkgConfig REQUIRED)
          string(MAKE_C_IDENTIFIER "native_test_${name}_${package}" prefix)
          pkg_check_modules(${prefix} REQUIRED IMPORTED_TARGET "${package}")
          if(field STREQUAL "packages")
            target_link_libraries(${name} PRIVATE PkgConfig::${prefix})
          else()
            target_include_directories(${name} SYSTEM PRIVATE ${${prefix}_INCLUDE_DIRS})
            # Header-only dependencies expose declarations and preprocessor
            # definitions without importing a library's build/link policy.
            # Match obs-build's headers_only(), rather than PkgConfig's full
            # imported target. Required extra flags belong in compile_options.
            foreach(flag IN LISTS ${prefix}_CFLAGS_OTHER)
              if(flag MATCHES "^-D(.+)$")
                target_compile_definitions(${name} PRIVATE "${CMAKE_MATCH_1}")
              endif()
            endforeach()
          endif()
        endforeach()
      endforeach()
      _obs_test_graph_array(archives "${graph}" targets "${name}" archives)
      foreach(archive IN LISTS archives)
        target_link_libraries(${name} PRIVATE OBS::${archive})
      endforeach()
      string(JSON sanitizer ERROR_VARIABLE error GET "${graph}" targets "${name}" sanitizers)
      if(NOT error)
        obs_test_sanitize(${name} "${sanitizer}")
      endif()
      _obs_test_graph_array(flags "${graph}" targets "${name}" compile_options_if_supported)
      if(flags)
        include(CheckCCompilerFlag)
        foreach(flag IN LISTS flags)
          string(MAKE_C_IDENTIFIER "native_test_flag_${flag}" variable)
          check_c_compiler_flag("${flag}" ${variable})
          if(${variable})
            target_compile_options(${name} PRIVATE "${flag}")
          endif()
        endforeach()
      endif()
    endforeach()
  endif()
  string(JSON count LENGTH "${graph}" tests)
  if(count GREATER 0)
    math(EXPR last "${count} - 1")
    foreach(index RANGE ${last})
      string(JSON name MEMBER "${graph}" tests ${index})
      _obs_test_graph_fields(
        "${graph}"
        "tests;${name}"
        "target;requires;command;timeout_seconds;skip_return_code;environment;working_directory;resource_locks;run_serial"
      )
      string(JSON target GET "${graph}" tests "${name}" target)
      string(JSON target_kind ERROR_VARIABLE error TYPE "${graph}" targets "${target}")
      if(error)
        message(FATAL_ERROR "Native test ${name} references absent target ${target}")
      endif()
      _obs_test_graph_requirement(selected "${graph}" tests "${name}" requires)
      if(NOT selected OR NOT target IN_LIST selected_targets)
        continue()
      endif()
      string(JSON command_kind ERROR_VARIABLE error TYPE "${graph}" tests "${name}" command)
      if(error)
        set(command "\${target}")
      else()
        _obs_test_graph_array(command "${graph}" tests "${name}" command)
      endif()
      if(NOT command)
        message(FATAL_ERROR "Native test ${name} has no command")
      endif()
      set(arguments)
      foreach(argument IN LISTS command)
        _obs_test_graph_expand(argument "${argument}" "${root}" "${target}")
        string(REPLACE ";" "\\;" argument "${argument}")
        list(APPEND arguments "${argument}")
      endforeach()
      add_test(NAME "${name}" COMMAND ${arguments})
      foreach(
        pair
        IN
        ITEMS
          "timeout_seconds;TIMEOUT"
          "skip_return_code;SKIP_RETURN_CODE"
          "working_directory;WORKING_DIRECTORY"
          "run_serial;RUN_SERIAL"
      )
        list(GET pair 0 field)
        list(GET pair 1 property)
        string(JSON value ERROR_VARIABLE error GET "${graph}" tests "${name}" ${field})
        if(NOT error)
          _obs_test_graph_expand(value "${value}" "${root}" "${target}")
          set_tests_properties("${name}" PROPERTIES ${property} "${value}")
        endif()
      endforeach()
      _obs_test_graph_array(locks "${graph}" tests "${name}" resource_locks)
      if(locks)
        set_tests_properties("${name}" PROPERTIES RESOURCE_LOCK "${locks}")
      endif()
      string(JSON count_environment ERROR_VARIABLE error LENGTH "${graph}" tests "${name}" environment)
      if(NOT error AND count_environment GREATER 0)
        math(EXPR last_environment "${count_environment} - 1")
        foreach(environment_index RANGE ${last_environment})
          string(JSON key MEMBER "${graph}" tests "${name}" environment ${environment_index})
          string(JSON value GET "${graph}" tests "${name}" environment "${key}")
          _obs_test_graph_expand(value "${value}" "${root}" "${target}")
          string(REPLACE ";" "\\;" assignment "${key}=${value}")
          set_property(TEST "${name}" APPEND PROPERTY ENVIRONMENT "${assignment}")
        endforeach()
      endif()
    endforeach()
  endif()
endfunction()
